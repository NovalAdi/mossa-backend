# ---------------------------------------------------------------------------
# Mossa Backend - Environment Variables
# Copy to .env and fill in real values (never commit real secrets)
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development

# Database
# PostgreSQL example:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/mossa_backend"

# JWT
JWT_SECRET=change-me-super-secret-key
JWT_EXPIRES_IN=7d

# CORS (frontend origin)
CORS_ORIGIN=http://localhost:3000

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
